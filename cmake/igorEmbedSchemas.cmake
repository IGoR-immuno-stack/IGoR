## Writes a C++ source that holds every *.schema.json file of SCHEMA_DIR, keyed by file name, so
## that the library validates documents without reading files at run time.
##
## cmake -DSCHEMA_DIR=<dir> -DOUTPUT=<file.cpp> -P igorEmbedSchemas.cmake

file(GLOB schema_files "${SCHEMA_DIR}/*.schema.json")
list(SORT schema_files)

set(source "// Generated by cmake/igorEmbedSchemas.cmake from ${SCHEMA_DIR}; do not edit.\n\n")
string(APPEND source "#include <map>\n#include <string>\n#include <string_view>\n\n")
string(APPEND source "namespace igor::model::schema::detail {\n\n")
string(APPEND source "const std::map<std::string, std::string_view> &embedded_schemas()\n{\n")
string(APPEND source "    static const std::map<std::string, std::string_view> files = {\n")
foreach(schema_file IN LISTS schema_files)
  get_filename_component(name "${schema_file}" NAME)
  file(READ "${schema_file}" content)
  string(LENGTH "${content}" length)
  # MSVC refuses a string literal longer than 16380 characters (C2026).
  if(length GREATER 16000)
    message(FATAL_ERROR "${name} is ${length} characters long: split it, MSVC cannot embed it in one literal")
  endif()
  string(APPEND source "        { \"${name}\", R\"igor_schema(${content})igor_schema\" },\n")
endforeach()
string(APPEND source "    };\n    return files;\n}\n\n}  // namespace igor::model::schema::detail\n")

file(WRITE "${OUTPUT}" "${source}")
