{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/IGoR-immuno-stack/IGoR/master/src/igor/Model/schemas/0.3/event-GeneChoice.schema.json",
  "title": "GeneChoice",
  "description": "Chooses a template, from its library, for its segment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "library",
    "priority",
    "targets",
    "realizations"
  ],
  "properties": {
    "type": {
      "const": "GeneChoice"
    },
    "library": {
      "enum": [
        "V_gene",
        "D_gene",
        "J_gene",
        "Undefined_gene"
      ],
      "description": "The template library it draws from, which also keys its alignments. Two choices may share one."
    },
    "priority": {
      "$ref": "common.schema.json#/definitions/priority"
    },
    "targets": {
      "$ref": "common.schema.json#/definitions/targets"
    },
    "realizations": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/definitions/named_realization"
      },
      "description": "The templates, by label: each must be in the library."
    }
  }
}
