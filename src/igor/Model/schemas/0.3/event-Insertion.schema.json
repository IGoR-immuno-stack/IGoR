{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/IGoR-immuno-stack/IGoR/master/src/igor/Model/schemas/0.3/event-Insertion.schema.json",
  "title": "Insertion",
  "description": "Sets the length of a junction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "priority",
    "targets",
    "realizations"
  ],
  "properties": {
    "type": {
      "const": "Insertion"
    },
    "priority": {
      "$ref": "common.schema.json#/definitions/priority"
    },
    "targets": {
      "$ref": "common.schema.json#/definitions/targets"
    },
    "realizations": {
      "type": "array",
      "description": "The numbers of nucleotides inserted.",
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/definitions/integer_realization"
          },
          {
            "properties": {
              "label": {
                "minimum": 0
              }
            }
          }
        ]
      }
    }
  }
}
